    },
    {
      "source": "/search",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/search/",
      "statusCode": 301
    },
    {
      "source": "/admin/:path*",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/",
      "statusCode": 301
    },
    {
      "source": "/api/:path*",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",

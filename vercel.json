{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",

  "redirects": [
    {
      "source": "/blogs/:slug",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/blogs/:slug/",
      "statusCode": 301
    },
    {
      "source": "/tags/:tag",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/tags/:tag/",
      "statusCode": 301
    },
    {
      "source": "/categories/:category",
      "destination": "https://koalalikecode.duykhanhchi1993.workers.dev/tags/",

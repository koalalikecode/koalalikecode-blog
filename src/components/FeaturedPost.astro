---
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import type { Post } from "../lib/posts";

interface Props {
  post: Post;
  href: string;
  readingTime: number;
}

const { post, href, readingTime } = Astro.props;
---

<article class="group mb-14">
  <a href={href} class="block cursor-pointer">
    {
      post.data.heroImage && (
        <div
          class="mb-6 overflow-hidden rounded-lg border"
          style="border-color: var(--border); background: var(--bg-subtle);"
        >
          <Image
            src={post.data.heroImage}
            alt=""
            widths={[480, 768, 1100]}
            sizes="(max-width: 768px) 100vw, 720px"
            loading="eager"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </div>
      )
    }

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="eyebrow" style="color: var(--accent);">Latest</span>
      <span class="text-xs" style="color: var(--text-faint);">
        <FormattedDate date={post.data.pubDate} />
      </span>
      <span class="text-xs" style="color: var(--text-faint);" aria-hidden="true">·</span>
      <span class="text-xs" style="color: var(--text-faint);">{readingTime} min read</span>
    </div>

    <h2 class="mt-2 text-3xl leading-tight sm:text-2xl" style="color: var(--text);">
      <span class="link-sweep">{post.data.title}</span>
    </h2>

    <p class="mt-3 max-w-2xl leading-relaxed" style="color: var(--text-muted);">
      {post.data.description}
    </p>
  </a>
</article>

---
/**
 * Comments via Giscus, backed by GitHub Discussions.
 * No database, no spam handling, and no XSS surface - GitHub renders
 * the content inside its own iframe.
 *
 * These ids are public identifiers, not secrets: Giscus runs client side, so
 * they are served in the page HTML by design.
 *
 * Announcements is used deliberately - only maintainers can open a discussion
 * in that category, so nobody can create junk threads, while readers can still
 * comment on the threads Giscus creates.
 *
 * Readers need a GitHub account to comment. That is the trade-off for having
 * no backend to run and nothing to moderate.
 */
const GISCUS = {
  repo: "koalalikecode/koalalikecode-blog",
  repoId: "R_kgDOH2jH8g",
  category: "Announcements",
  categoryId: "DIC_kwDOH2jH8s4DFbe_",
};

const configured = GISCUS.repoId !== "" && GISCUS.categoryId !== "";
---

{
  configured ? (
    <div class="giscus" />
  ) : (
    <p class="text-sm" style="color: var(--text-muted);">
      Comments are not configured yet. See the setup notes in
      <code
        class="rounded px-1 py-0.5 text-xs"
        style="background: var(--bg-subtle); border: 1px solid var(--border);"
      >
        src/components/Comments.astro
      </code>
      .
    </p>
  )
}

{
  configured && (
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={GISCUS.category}
      data-category-id={GISCUS.categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    />
  )
}

{/*
  This script stays OUTSIDE the `configured &&` expression on purpose.
  Astro compiles <script> tags separately from the template, and one placed
  inside a conditional expression is dropped from the output entirely - which
  is exactly what happened the first time. Guarding inside the script instead
  keeps it in the bundle and costs nothing on pages with no comments.
*/}
<script>
  // Giscus renders in an iframe on its own origin, so it cannot read this
  // page's theme. Push the current theme to it on load and on every toggle,
  // otherwise the comment box stays light while the site is dark.
  const ORIGIN = "https://giscus.app";

  function currentTheme(): "light" | "dark" {
    const explicit = document.documentElement.getAttribute("data-theme");
    if (explicit === "light" || explicit === "dark") return explicit;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function pushTheme(theme: string) {
    const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, ORIGIN);
  }

  // Only wire up on pages that actually render the widget
  if (document.querySelector(".giscus")) {
    // The iframe is created asynchronously by client.js, so wait for its ready
    // message rather than guessing at a timeout.
    window.addEventListener("message", (event: MessageEvent) => {
      if (event.origin !== ORIGIN) return;
      if (!event.data || typeof event.data !== "object" || !("giscus" in event.data)) return;
      pushTheme(currentTheme());
    });

    document.addEventListener("themechange", (event) => {
      const detail = (event as CustomEvent<{ theme?: string }>).detail;
      pushTheme(detail?.theme ?? currentTheme());
    });
  }
</script>

---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  readingTime: number;
  tags?: string[];
}

const { title, description, href, pubDate, readingTime, tags = [] } = Astro.props;
---

{/*
  Asymmetric two-column grid on desktop: date rail on the left, content on the right.
  The rail gives the list a spine to scan down, which a flat stack lacks.
  Collapses to a single column below the sm breakpoint.
*/}
<article class="group border-b" style="border-color: var(--border);">
  <a
    href={href}
    class="grid cursor-pointer grid-cols-1 gap-x-8 gap-y-1 py-6 sm:grid-cols-[7rem_1fr]"
  >
    <div class="pt-1">
      <span class="text-xs tabular-nums" style="color: var(--text-faint);">
        <FormattedDate date={pubDate} />
      </span>
    </div>

    <div class="min-w-0">
      <h3 class="text-xl leading-snug" style="color: var(--text);">
        <span class="link-sweep">{title}</span>
      </h3>

      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed" style="color: var(--text-muted);">
        {description}
      </p>

      <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-xs" style="color: var(--text-faint);">{readingTime} min read</span>
        {
          tags.length > 0 && (
            <>
              <span class="text-xs" style="color: var(--text-faint);" aria-hidden="true">
                ·
              </span>
              <span class="text-xs" style="color: var(--text-faint);">
                {tags.join(", ")}
              </span>
            </>
          )
        }
      </div>
    </div>
  </a>
</article>

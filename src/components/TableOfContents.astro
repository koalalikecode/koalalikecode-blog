---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only h2 and h3 - deeper levels make the outline noisy
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <nav
      class="mb-10 rounded-lg border p-4"
      style="border-color: var(--border); background: var(--bg-subtle);"
      aria-label="Table of contents"
    >
      <details open>
        <summary
          class="cursor-pointer text-xs font-medium uppercase tracking-widest"
          style="color: var(--text-faint);"
        >
          Contents
        </summary>
        <ul class="mt-3 space-y-1.5 text-sm">
          {items.map((h) => (
            <li class={h.depth === 3 ? "pl-4" : ""}>
              <a
                href={`#${h.slug}`}
                class="toc-link transition-colors hover:underline"
                style="color: var(--text-muted); text-underline-offset: 0.2em;"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<style>
  /* The section being read, set by the IntersectionObserver below */
  .toc-link[data-current="true"] {
    color: var(--accent) !important;
    font-weight: 500;
  }
</style>

<script>
  // Highlight the section currently being read.
  // IntersectionObserver rather than measuring offsetTop in a scroll handler:
  // the browser does the work, no layout thrashing, no code running every frame.
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  if (links.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => {
      const id = decodeURIComponent(link.hash.slice(1));
      if (id) byId.set(id, link);
    });

    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = entry.target.id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }

        // The topmost visible heading is the one being read
        let current: string | null = null;
        for (const [id] of byId) {
          if (visible.has(id)) {
            current = id;
            break;
          }
        }

        byId.forEach((link, id) => {
          link.dataset.current = String(id === current);
        });
      },
      // Only count the upper part of the viewport so the highlight moves at the right time
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    );

    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>

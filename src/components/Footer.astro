---
import { SOCIALS, AUTHOR } from "../consts";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t" style="border-color: var(--border);">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
    style="color: var(--text-muted);"
  >
    <p>© {year} {AUTHOR.name}</p>

    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Social links">
      {
        SOCIALS.map((s) => (
          <a
            href={s.href}
            class="cursor-pointer transition-colors hover:text-[var(--accent)]"
            rel={s.href.startsWith("http") ? "me noopener" : undefined}
            target={s.href.startsWith("http") ? "_blank" : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

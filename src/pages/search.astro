---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search" description="Search the blog.">
  <header class="mb-8">
    <h1 class="text-3xl" style="color: var(--text);">Search</h1>
    <p class="mt-2 text-sm" style="color: var(--text-muted);">Full-text search across every post.</p>
  </header>

  <div id="search"></div>

  <noscript>
    <p style="color: var(--text-muted);">
      Search needs JavaScript enabled. You can browse every post on the
      <a href="/" style="color: var(--accent); text-decoration: underline;">home page</a>.
    </p>
  </noscript>
</BaseLayout>

<style is:global>
  /* Blend Pagefind's default UI into the site palette */
  :root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: var(--font-sans);
  }

  .pagefind-ui__result-title a {
    color: var(--text) !important;
  }

  .pagefind-ui__result-excerpt mark {
    background: var(--selection);
    color: var(--text);
    border-radius: 2px;
  }
</style>

<script>
  // Pagefind only exists AFTER `astro build` runs (the index-building step).
  // It has to be loaded with a <script> tag at runtime rather than import():
  // a bundler would try to resolve the path at build time and fail.
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = src;
      el.onload = () => resolve();
      el.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(el);
    });
  }

  async function initSearch() {
    const container = document.getElementById("search");
    if (!container) return;

    try {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(css);

      await loadScript("/pagefind/pagefind-ui.js");

      // @ts-expect-error - PagefindUI is attached to window by the script above
      new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        excerptLength: 25,
      });
    } catch {
      container.innerHTML =
        '<p style="color: var(--text-muted);">The search index has not been built yet. Run <code>npm run build</code> then <code>npm run preview</code> to try it.</p>';
    }
  }

  initSearch();
</script>

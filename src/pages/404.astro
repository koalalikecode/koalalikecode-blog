---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại.">
  <div class="py-16 text-center">
    <p class="mb-2 text-sm font-medium" style="color: var(--text-faint);">404</p>
    <h1 class="mb-3 text-2xl font-semibold tracking-tight">Không tìm thấy trang</h1>
    <p class="mb-8" style="color: var(--text-muted);">
      Trang bạn tìm không tồn tại hoặc đã được chuyển đi nơi khác.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-md border px-4 py-2 text-sm transition-colors"
        style="border-color: var(--border); color: var(--text);"
      >
        Về trang chủ
      </a>
      <a
        href="/search"
        class="rounded-md px-4 py-2 text-sm transition-colors"
        style="color: var(--text-muted);"
      >
        Tìm kiếm
      </a>
    </div>
  </div>
</BaseLayout>

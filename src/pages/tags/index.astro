---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagCounts, tagUrl } from "../../lib/posts";

const tags = await getTagCounts();
const max = Math.max(1, ...tags.map((t) => t.count));

/**
 * Scale a tag's type size by how often it's used, so the page reads as a
 * weighted index rather than a uniform row of pills. Kept to a narrow range
 * (1rem - 1.6rem) so it stays restrained.
 */
const sizeFor = (count: number) => 1 + (count / max) * 0.6;
---

<BaseLayout title="Tags" description="All topics on the blog.">
  <header class="mb-10">
    <h1 class="text-3xl" style="color: var(--text);">Tags</h1>
    <p class="mt-2 text-sm" style="color: var(--text-muted);">
      {tags.length} topics across the archive.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <p style="color: var(--text-muted);">No tags yet.</p>
    ) : (
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-4">
        {tags.map(({ tag, count }) => (
          <li>
            <a
              href={tagUrl(tag)}
              class="group inline-flex cursor-pointer items-baseline gap-1.5 font-serif transition-colors hover:text-[var(--accent)]"
              style={`font-size: ${sizeFor(count)}rem; color: var(--text);`}
            >
              <span class="link-sweep">{tag}</span>
              <span class="font-sans text-xs tabular-nums" style="color: var(--text-faint);">
                {count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

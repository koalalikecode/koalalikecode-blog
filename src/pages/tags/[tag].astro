---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListItem from "../../components/PostListItem.astro";
import { getPublishedPosts, postUrl, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged ${tag}.`}>
  <div class="mb-8">
    <a
      href="/tags/"
      class="eyebrow mb-4 inline-flex cursor-pointer items-center gap-1.5 transition-colors hover:text-[var(--accent)]"
    >
      <span aria-hidden="true">←</span> All tags
    </a>
    <h1 class="text-3xl" style="color: var(--text);">#{tag}</h1>
    <p class="mt-1 text-sm" style="color: var(--text-muted);">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
  </div>

  <div>
    {
      posts.map((post) => (
        <PostListItem
          title={post.data.title}
          description={post.data.description}
          href={postUrl(post)}
          pubDate={post.data.pubDate}
          readingTime={readingTime(post.body ?? "")}
          tags={post.data.tags}
        />
      ))
    }
  </div>
</BaseLayout>
